# Copy to .env for local development. In production every value is a
# Shipyard environment variable; see README.md → Deploying.

# ---- Database (Shipyard injects both when the backend is provisioned) ----
DATABASE_URL="postgresql://postgres@localhost:5441/brandloom_dev"
DIRECT_URL="postgresql://postgres@localhost:5441/brandloom_dev"
# Only for `npm run test:db` — must be a database named brandloom_test
TEST_DATABASE_URL="postgresql://postgres@localhost:5441/brandloom_test"

# ---- Media storage (production only) ----
# MEDIA_STORAGE_URL="http://sb-storage-brandloom:5000"
# SUPABASE_SERVICE_ROLE_KEY is injected by Shipyard

# ---- Site ----
BETTER_AUTH_SECRET="<64 random hex chars>"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Base of the public image URLs Meta downloads. Must be public HTTPS in production.
PUBLIC_BASE_URL="http://localhost:3000"
# Only these addresses can create an account; they become ADMIN.
ALLOWED_SIGNUP_EMAILS="kamal@jnknutrition.com"

# Encrypts the Instagram page tokens at rest. 64 hex chars. Back it up:
# losing it means reconnecting every brand.
TOKEN_ENCRYPTION_KEY="<64 random hex chars>"

# ---- Scheduler (scripts/boot.mjs → POST /api/internal/tick) ----
SCHEDULER_ENABLED="true"
SCHEDULER_SECRET="<random string>"
# SCHEDULER_INTERVAL_MS="30000"
# PUBLISH_DAILY_CAP="25"
APP_TIMEZONE="Asia/Dubai"

# ---- Meta (docs/META_SETUP.md) ----
META_APP_ID=""
META_APP_SECRET=""
META_CONFIG_ID=""
META_GRAPH_VERSION="v24.0"
